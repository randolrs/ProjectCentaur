# Copy to .env.local for local development. Never commit real secrets.

# --- Supabase Postgres (Drizzle connection) ---
# Project Settings -> Database -> Connection string.
# Use the pooled "Transaction" connection (port 6543) for serverless / Vercel.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres"

# --- Supabase project (client + server SDKs, wired in M1) ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- theracingapi.com (North America add-on) ---
# Credentials are issued as a username/password pair, sent via HTTP Basic auth.
RACING_API_BASE_URL="https://api.theracingapi.com"
RACING_API_USERNAME=""
RACING_API_PASSWORD=""

# --- Anthropic API (conversational onboarding + digest reasoning, M2+) ---
ANTHROPIC_API_KEY=""

# --- Cron (race ingestion + digest delivery) ---
# Shared secret guarding GET /api/cron/ingest and /api/cron/digest. Vercel
# Cron attaches this as a bearer token automatically when the env var is set;
# generate a long random value (e.g. `openssl rand -hex 32`).
CRON_SECRET=""

# --- Resend (digest email delivery, M4) ---
# DIGEST_FROM_EMAIL must be an address on a domain verified in Resend.
RESEND_API_KEY=""
DIGEST_FROM_EMAIL="digest@yourdomain.com"

# --- Stripe ---
# TODO(M5): integrated checkout + paywall. Not used before M5.
STRIPE_SECRET_KEY=""
